<?xml version="1.0" encoding="utf-8"?>
<!--
    Privileged-permission allowlist for Ashu Phone when installed as a
    priv-app via this Magisk module.

    CAPTURE_AUDIO_OUTPUT is the specific signature|privileged permission
    Android's audio policy service checks before allowing
    MediaRecorder.AudioSource.VOICE_CALL, VOICE_UPLINK, or VOICE_DOWNLINK
    to open (confirmed against BCR's own README, a call recorder proven
    to get two-way call-audio capture working on real rooted devices -
    BCR documents this single permission as gating all three of those
    AudioSource values, not just VOICE_CALL alone).

    READ_LOGS is also allowlisted here, matching SKVALEX's (a second,
    independently working rooted call recorder) own privapp-permissions
    XML, which requests exactly these same two permissions and nothing
    else for call recording to work.

    Both permissions only take effect if the app's own manifest also
    requests them via <uses-permission> - an allowlist entry alone grants
    nothing to an app that never asked for the permission in the first
    place.
-->
<permissions>
    <privapp-permissions package="com.ashudialer.app">
        <permission name="android.permission.CAPTURE_AUDIO_OUTPUT" />
        <permission name="android.permission.READ_LOGS" />
    </privapp-permissions>
</permissions>
