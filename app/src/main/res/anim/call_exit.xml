<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/accelerate_cubic">
    <!-- Never fade the Activity to transparent: on some OEMs that exposes the
         starting/window surface underneath and produces the blue blank frame
         seen immediately after hang-up. Keep the call window opaque until the
         transition completes, then reveal the already-running dialer. -->
    <scale
        android:fromXScale="1.0"
        android:toXScale="0.985"
        android:fromYScale="1.0"
        android:toYScale="0.985"
        android:pivotX="50%"
        android:pivotY="50%"
        android:duration="150" />
</set>
