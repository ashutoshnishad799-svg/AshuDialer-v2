<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Matches CallRecorder's File(context.filesDir, "recordings") output directory. -->
    <files-path name="recordings" path="recordings/" />
    <!--
      Matches CallRecorder.PRIVATE_SPACE_RECORDINGS_DIR
      (File(context.filesDir, "private_space_recordings")) - this was
      missing, which is why generating a content:// Uri for any Private
      Space recording threw "Failed to find configured root that contains
      .../private_space_recordings/..." (IllegalArgumentException) the
      moment playback or sharing tried to resolve one. FileProvider only
      grants access to paths explicitly declared here; the public
      "recordings" entry above never covered this separate, more restricted
      directory.
    -->
    <files-path name="private_space_recordings" path="private_space_recordings/" />
    <cache-path name="update_apks" path="updates/" />
    <cache-path name="shared_contacts" path="shared_contacts/" />
</paths>
