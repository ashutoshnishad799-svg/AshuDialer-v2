<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        Diagonal teal gradient using the app's own accent colors
        (DialerColors.kt: accent #0F8A7C / swatchEnd #0F8A7C / lighter
        #52C4B0), rather than a flat dark rectangle — this is what makes
        the call notification read as "our app" at a glance in the shade/
        Control Center instead of looking like a generic system alert.
        A dark base (#101A18) is blended in via the angle so text stays
        legible over both ends of the gradient.
    -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#E01A6E5E"
                android:centerColor="#E00F4E44"
                android:endColor="#F00B2E28" />
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="#4DB9EDE0" />
        </shape>
    </item>
    <!--
        Soft highlight band across the top third only — this is what sells
        "glass" over "gradient card": a curved surface catches light unevenly,
        so the sheen fades out before reaching the middle rather than covering
        the whole card evenly.
    -->
    <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#38FFFFFF"
                android:centerColor="#0AFFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
            <!--
              Bottom corners must carry the same 23dp radius as the top ones.
              This layer previously stretched from top=1dp all the way to the
              unclipped bottom edge of the notification while only its top-left/
              top-right corners were rounded, so its square bottom-left/
              bottom-right corners stuck out past the outer shape's rounded
              24dp corners - visible as sharp corners peeking out at the
              bottom of the call notification.
            -->
            <corners android:radius="23dp" />
        </shape>
    </item>
    <!-- Hairline inner edge just inside the outer stroke, for a bit of depth/bevel. -->
    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#14FFFFFF" />
            <corners android:radius="22dp" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
