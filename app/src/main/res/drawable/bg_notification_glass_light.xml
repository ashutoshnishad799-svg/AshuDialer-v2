<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        Light counterpart of bg_notification_glass.xml, used when the
        person's chosen in-app theme is a light one (see
        CallNotificationHelper.themeIsDark) - the notification previously
        used this same dark teal-glass background unconditionally, so on
        a light theme it looked like a mismatched dark patch sitting on
        top of an otherwise light phone (status bar, lock screen, shade
        all light) rather than blending in the way this app's own light
        themes do everywhere else. Same diagonal-gradient + top-sheen +
        inner-hairline structure as the dark version for a consistent
        "glass" read, just with a soft near-white base instead of a dark
        teal one, using the same teal accent family as WhitePalette/
        GradientPalette (#0F8A7C) so it still reads as this app.
    -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#F2FFFFFF"
                android:centerColor="#F0EFFBF7"
                android:endColor="#F5DCF5EE" />
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="#4D0F8A7C" />
        </shape>
    </item>
    <!-- Same top-third sheen band as the dark version, just a darker highlight so it still reads against a light base. -->
    <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#22FFFFFF"
                android:centerColor="#0AFFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
            <corners android:radius="23dp" />
        </shape>
    </item>
    <!-- Hairline inner edge, darker than the dark version's since it sits on a light base. -->
    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#140B2E28" />
            <corners android:radius="22dp" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
