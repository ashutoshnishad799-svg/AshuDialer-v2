<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive-icon background for the "Contacts" launcher alias - same green
    (#3DBB4E) as ic_launcher_background.xml (the Phone alias), not the earlier
    HyperOS-style blue. The user supplied a real reference image for this icon
    (a green glossy person-glyph, matching the Phone icon's own green family)
    the same way ic_launcher_background/foreground.xml were already built to
    match a green phone-glyph reference - this brings the adaptive-icon layer
    back in line with that image and with the legacy PNG fallback
    (mipmap-*/ic_launcher_contacts_png.png), which is now that same reference
    image directly. Before this fix the two paths disagreed (green legacy PNG,
    blue adaptive icon), showing a different color depending on which one a
    given launcher/Android version actually used.
    Plain rectangle, no baked-in corner rounding, since the adaptive-icon
    system clips this to whatever mask shape the launcher uses.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z" android:fillColor="#3DBB4E" />
</vector>
