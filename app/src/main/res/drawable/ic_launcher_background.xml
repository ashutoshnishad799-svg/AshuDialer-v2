<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive-icon background layer — diagonal blue → purple → teal
    gradient matching the "Ashu Dialer" reference sheet (#6366FF →
    #A855F7 → #00E5FF family). Kept as a plain gradient rectangle (no
    shapes/glow here) because the adaptive-icon system already clips
    this to whatever mask shape the launcher uses (circle, squircle,
    rounded-square) — baking a fixed rounded-rect edge into this layer
    would double up with or fight that clip on launchers using a
    different mask.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="8"
                android:startY="4"
                android:endX="100"
                android:endY="104"
                android:startColor="#6366FF"
                android:centerColor="#A855F7"
                android:endColor="#00E5FF" />
        </aapt:attr>
    </path>
</vector>
