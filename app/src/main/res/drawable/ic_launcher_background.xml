<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive-icon background layer - solid green matching the reference
    icon (a green rounded-square phone glyph, #3DBB4E-family green rather
    than this app's earlier blue -> purple -> teal gradient). Kept as a
    flat solid rather than a gradient since the reference is flat, and as
    a plain rectangle (no baked-in corner rounding) for the same reason
    the previous background was: the adaptive-icon system clips this to
    whatever mask shape the launcher uses, so a fixed rounded edge here
    would fight that clip on a launcher using a different mask.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z" android:fillColor="#3DBB4E" />
</vector>

