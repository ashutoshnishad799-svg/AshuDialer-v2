<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive-icon foreground — glossy white handset (left) + 3x3 dial-pad
    dot grid (right), matching the reference sheet's icon. Both shapes sit
    inside the 66dp "safe zone" (out of the full 108dp canvas) that
    Android's adaptive-icon spec keeps guaranteed-visible across every
    launcher mask shape (circle/squircle/rounded-square/teardrop) — content
    outside that zone can get clipped depending on which mask a given
    launcher uses, so nothing here extends past it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Subtle inner glow ring behind the handset for the "glassy/HDR" feel from the reference -->
    <path android:fillColor="#26FFFFFF" android:pathData="M54,54m-30,0a30,30 0,1 1,60 0a30,30 0,1 1,-60 0" />

    <!-- Handset — rounded phone-receiver silhouette, glossy white with a soft vertical highlight gradient -->
    <path android:pathData="M38.5,36.2 C41.8,32.6 46.4,31.4 49.9,34.4 L53.8,37.8 C56.3,40 56.7,43.7 54.7,46.3 L52.3,49.4 C51.6,50.3 51.6,51.5 52.3,52.4 C55.6,56.6 59.7,60.2 64.4,63 C65.4,63.6 66.6,63.5 67.4,62.7 L70.2,59.9 C72.6,57.5 76.4,57.3 79,59.4 L83.2,62.8 C86.6,65.6 87.1,70.6 84.2,73.9 C80,78.8 73.3,81 66.8,78.6 C55.2,74.3 45.1,66.3 38.6,55.3 C33.6,46.9 33.7,40.9 38.5,36.2 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="35"
                android:startY="30"
                android:endX="87"
                android:endY="80"
                android:startColor="#FFFFFF"
                android:endColor="#DCEBFF" />
        </aapt:attr>
    </path>

    <!-- 3x3 dial-pad dot grid, upper-right of the handset -->
    <path android:fillColor="#FFFFFFFF" android:pathData="M65,32 m-3.4,0 a3.4,3.4 0,1 1,6.8 0 a3.4,3.4 0,1 1,-6.8 0" />
    <path android:fillColor="#FFFFFFFF" android:pathData="M76,32 m-3.4,0 a3.4,3.4 0,1 1,6.8 0 a3.4,3.4 0,1 1,-6.8 0" />
    <path android:fillColor="#FFFFFFFF" android:pathData="M65,43 m-3.4,0 a3.4,3.4 0,1 1,6.8 0 a3.4,3.4 0,1 1,-6.8 0" />
    <path android:fillColor="#F0F4FF" android:pathData="M76,43 m-3.4,0 a3.4,3.4 0,1 1,6.8 0 a3.4,3.4 0,1 1,-6.8 0" />
    <path android:fillColor="#E4ECFF" android:pathData="M65,54 m-3.4,0 a3.4,3.4 0,1 1,6.8 0 a3.4,3.4 0,1 1,-6.8 0" />
    <path android:fillColor="#DCE6FF" android:pathData="M76,54 m-3.4,0 a3.4,3.4 0,1 1,6.8 0 a3.4,3.4 0,1 1,-6.8 0" />
</vector>
