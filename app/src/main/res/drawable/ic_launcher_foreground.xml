<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive-icon foreground - white glossy phone-receiver silhouette with
    two curved sound-wave arcs to its upper right, matching the reference
    green phone icon (a large centered handset + soundwaves, no dial-pad
    dots, unlike this app's earlier foreground). Content stays inside the
    66dp "safe zone" (of the full 108dp canvas) that Android's
    adaptive-icon spec keeps guaranteed-visible across every launcher mask
    shape (circle/squircle/rounded-square/teardrop) - nothing here extends
    past it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Handset - classic receiver silhouette (two rounded earpieces joined by a curved
         bridge), tilted like a phone held to the ear, matching the reference's pose. -->
    <path android:pathData="M38.8,33.2 C42.4,29.4 48.3,29.2 52.1,32.8 L56.6,37 C59.8,40 60.2,44.9 57.5,48.3 L54.6,52 C53.7,53.1 53.7,54.6 54.6,55.7 C59.2,61.5 65.1,66.2 71.9,69.4 C73.2,70 74.7,69.8 75.7,68.8 L79.1,65.5 C82.2,62.5 87,62.2 90.5,64.8 L95.4,68.5 C99.5,71.6 100.1,77.6 96.6,81.4 C90.9,87.7 82.1,90.6 73.5,87.6 C58.2,82.3 45.6,71.9 37.4,58.3 C31.3,48.1 31.6,40.4 38.8,33.2 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="32"
                android:startY="28"
                android:endX="98"
                android:endY="90"
                android:startColor="#FFFFFF"
                android:endColor="#EAF5EC" />
        </aapt:attr>
    </path>

    <!-- Soft shadow beneath the handset, same "glossy 3D" cue the previous icon's inner glow ring gave. -->
    <path android:fillColor="#1A0B3D14" android:pathData="M42,60 m-24,0 a24,20 0,1 1,48 0 a24,20 0,1 1,-48 0" />

    <!-- Two curved soundwave arcs, upper-right of the handset. -->
    <path android:fillColor="#00000000" android:pathData="M70,24 C79,27 86,35 87,45" android:strokeColor="#FFFFFF" android:strokeWidth="6.5" android:strokeLineCap="round" />
    <path android:fillColor="#00000000" android:pathData="M67,34 C73,36.5 77.5,41.5 78.5,48" android:strokeColor="#FFFFFF" android:strokeWidth="6.5" android:strokeLineCap="round" />
</vector>

