<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="rectangle">
        <gradient android:angle="135" android:startColor="#F4B6EBDC" android:centerColor="#EEB1E8D9" android:endColor="#F2A1DFD0" />
        <corners android:radius="24dp" />
        <stroke android:width="1dp" android:color="#660F8A7C" />
    </shape></item>
    <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="1dp"><shape android:shape="rectangle">
        <gradient android:angle="90" android:startColor="#30FFFFFF" android:centerColor="#08FFFFFF" android:endColor="#00FFFFFF" />
        <corners android:radius="23dp" />
    </shape></item>
    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp"><shape android:shape="rectangle">
        <stroke android:width="1dp" android:color="#280F8A7C" />
        <corners android:radius="22dp" />
        <solid android:color="@android:color/transparent" />
    </shape></item>
</layer-list>
