<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="10dp"
    android:background="@drawable/bg_notification_compact">

    <ImageView
        android:id="@+id/compact_avatar"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_notification_avatar"
        android:src="@drawable/ic_call_notification"
        android:padding="9dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:orientation="vertical">
        <TextView
            android:id="@+id/compact_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#F5F5F5"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/compact_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#B8B8B8"
            android:textSize="11sp"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/compact_speaker"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/bg_notification_compact_off"
        android:gravity="center">
        <ImageView
            android:id="@+id/compact_speaker_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_notif_speaker" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/compact_mute"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/bg_notification_compact_off"
        android:gravity="center">
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_notif_mute" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/compact_end"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/bg_notification_compact_end"
        android:gravity="center">
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_notif_end_call" />
    </LinearLayout>
</LinearLayout>
